
/**
 * @fileoverview Firestore Security Rules for the EveCount Platform
 * @author EveCount Security Rules Architect
 *
 * @description
 * This ruleset governs access to the EveCount Firestore database. It is a core
 * component of our Clear-Box Intelligence Blueprint, designed to enable and
 * protect our autonomous agentic operations.
 *
 * @philosophy
 * The security philosophy is built on the principle of least privilege and is
 * designed to support a system of **Traceable Intelligence**. It enforces strict
 * data access patterns that ensure the integrity and auditability of every
 * agent-driven action. The rules establish three primary access patterns:
 * 1. Public Read-Only: For data intended for public consumption.
 * 2. Secure Write-Only Drop-Box: For all inbound submissions, protecting data at ingress.
 * 3. Role-Based Access Control (RBAC): For human oversight and administrative control
 *    within the Command Center, distinguishing between 'admin', 'partner', and 'user' roles.
 *
 * @structure
 * The database uses a flat, non-hierarchical structure to enable traceable,
 * independent agent actions.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    //================================================================================
    // Helper Functions
    //================================================================================

    /**
     * @description Checks if the user is authenticated, including anonymous users.
     * @returns {boolean} True if the request has a non-null auth object.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the requesting user's UID matches the document's userId.
     * @param {string} userId The UID to check against.
     * @returns {boolean} True if the UIDs match.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Retrieves the data for the currently authenticated user from the /users collection.
     * @returns {object} The user's document data.
     */
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    /**
     * @description Checks if the currently authenticated user has the 'admin' role.
     * @returns {boolean} True if the user is an admin.
     */
    function isAdmin() {
      return isSignedIn() && getUserData().role == 'admin';
    }

    /**
     * @description Checks if the currently authenticated user has the 'partner' role.
     * @returns {boolean} True if the user is a partner.
     */
    function isPartner() {
      return isSignedIn() && getUserData().role == 'partner';
    }


    //================================================================================
    // Collection: ventures
    //================================================================================
    /**
     * @description Public portfolio information. Readable by anyone, but locked for client-side writes.
     */
    match /ventures/{ventureId} {
      allow get, list: if true;
      allow create, update, delete: if false; // Writes must be handled by a trusted backend/admin.
    }


    //================================================================================
    // Collection: submissions
    //================================================================================
    /**
     * @description Secure drop-box for new ideas. Any authenticated user (including anonymous) can submit.
     *   Admins and partners can read submissions, but only admins can modify them.
     */
    match /submissions/{submissionId} {
      allow create: if isSignedIn();
      allow get, list: if isAdmin() || isPartner();
      allow update, delete: if isAdmin();
    }
    
    
    //================================================================================
    // Collection: users
    //================================================================================
    /**
     * @description Stores user profiles and roles for access control.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin();
      allow delete: if isAdmin();
      
      /**
       * @description Stores the chat history for a specific user with a specific command center agent.
       */
      match /agentConversations/{agentId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    //================================================================================
    // Collection: outreachProposals
    //================================================================================
    /**
     * @description Admin-only collection for the agent-generated proposals. Serves as the "Outbox"
     * for the Clear-Box Dashboard.
     */
    match /outreachProposals/{proposalId} {
      allow read, write: if isAdmin();
    }

    //================================================================================
    // Collection: sources
    //================================================================================
    /**
     * @description Admin-managed collection for the Intelligence cluster's data sources.
     */
    match /sources/{sourceId} {
      allow read, write: if isAdmin();
    }

    //================================================================================
    // Collection: incubatorMembers
    //================================================================================
    /**
     * @description Roster of AI practitioners. Publicly readable. Admin-only writes.
     */
    match /incubatorMembers/{memberId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    //================================================================================
    // Collection: challenges
    //================================================================================
    /**
     * @description Incubator challenge board. Publicly readable. Admin-only writes.
     */
    match /challenges/{challengeId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    //================================================================================
    // Collection: guardrailSources
    //================================================================================
    /**
     * @description Admin/Partner-managed collection for AI guardrail sources.
     */
    match /guardrailSources/{sourceId} {
      allow read, write: if isAdmin() || isPartner();
    }
  }
}
